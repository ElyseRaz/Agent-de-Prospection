# --- Postgres -----------------------------------------------------------
POSTGRES_USER=remoteradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=remoteradar

# URL asyncpg utilisee par l'API/worker, URL psycopg2 utilisee par Alembic.
DATABASE_URL=postgresql+asyncpg://remoteradar:change-me@db:5432/remoteradar
DATABASE_URL_SYNC=postgresql+psycopg2://remoteradar:change-me@db:5432/remoteradar

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Application ------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost,http://localhost:5173

# --- LLM (extraction structuree, phase 3) ------------------------------------
# Cle API Anthropic, lue directement par le SDK (jamais stockee ailleurs).
ANTHROPIC_API_KEY=
# Modele utilise pour l'extraction structuree. claude-sonnet-5 recommande pour
# ce cas d'usage a fort volume (extraction fermee, pas de raisonnement complexe).
LLM_MODEL=claude-sonnet-5

# --- A renseigner a partir de la phase 5 (reputation entreprise) ------------
# TRUSTPILOT_API_KEY=

# --- A renseigner a partir de la phase 8 (notifications) --------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=
# SENTRY_DSN=
