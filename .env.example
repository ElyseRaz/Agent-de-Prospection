# --- Postgres -----------------------------------------------------------
POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadpilot

# URL au format standard `postgres://` - utilisee telle quelle par pgx (API/
# worker Go) et par golang-migrate (service `migrate`), pas de variante
# separee necessaire contrairement a asyncpg/psycopg2 avant.
DATABASE_URL=postgres://leadpilot:change-me@db:5432/leadpilot?sslmode=disable

# --- Redis (jobs asynchrones Asynq) ------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Application --------------------------------------------------------------
APP_ENV=development
PORT=8000
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost,http://localhost:3000

# --- Enrichissement (phase 3) --------------------------------------------------
# Chaque fournisseur est independant et optionnel : absent, il est
# simplement saute (voir internal/reputation et internal/ai), jamais une
# erreur au demarrage.
# TRUSTPILOT_API_KEY=
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b

# --- Campagnes email (phase 4) --------------------------------------------------
# SMTP optionnel : sans lui, l'envoi de campagne est simplement laisse en
# brouillon (voir internal/tasks/send_campaign.go). PUBLIC_APP_URL sert a
# construire le lien de desinscription absolu insere dans chaque email.
# Exemple avec Brevo (smtp-relay.brevo.com:587, cle SMTP generee dans
# Parametres > SMTP & API > SMTP). Plan gratuit Brevo = 300 mails/jour max.
# SMTP_FROM doit etre une adresse sur un domaine verifie (SPF/DKIM) dans
# Brevo, sinon risque de rejet/spam chez les autres fournisseurs.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
DAILY_SEND_LIMIT=100
PUBLIC_APP_URL=http://localhost
