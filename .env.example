# --- Postgres -----------------------------------------------------------
POSTGRES_USER=remoteradar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=remoteradar

# URL asyncpg utilisee par l'API/worker, URL psycopg2 utilisee par Alembic.
DATABASE_URL=postgresql+asyncpg://remoteradar:change-me@db:5432/remoteradar
DATABASE_URL_SYNC=postgresql+psycopg2://remoteradar:change-me@db:5432/remoteradar

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Application ------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost,http://localhost:5173

# --- LLM (extraction structuree phase 3, score de risque phase 5) -----------
# Fournisseur par defaut : Anthropic (Claude). Cle lue directement par le SDK
# (jamais stockee ailleurs).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
# Modele utilise pour l'extraction structuree. claude-sonnet-5 recommande pour
# ce cas d'usage a fort volume (extraction fermee, pas de raisonnement complexe).
LLM_MODEL=claude-sonnet-5

# Pour utiliser une passerelle compatible OpenAI a la place (ex: opencode.ai) :
# decommenter les 4 lignes suivantes. ATTENTION : aucun tarif public connu
# pour un modele expose par une passerelle tierce -> le cout journalise dans
# llm_calls sera 0$ tant que backend/app/normalization/llm_common.py
# (PRICING_USD_PER_MTOK) n'est pas complete manuellement pour ce modele.
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_API_KEY=
# LLM_MODEL=gpt-5.6-luna

# --- Reputation entreprise (phase 5) -----------------------------------------
# API Business Units (publique) de Trustpilot - acces partenaire payant.
# Optionnelle : sans elle, la verification de reputation est simplement sautee
# (le score de risque continue de fonctionner sur les autres signaux).
# TRUSTPILOT_API_KEY=

# --- A renseigner a partir de la phase 8 (notifications) --------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=
# SENTRY_DSN=
